-- CampusFind PostgreSQL database

BEGIN;

CREATE SCHEMA IF NOT EXISTS "user";

CREATE TABLE IF NOT EXISTS "user".users (
    user_id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    full_name VARCHAR(150) NOT NULL CHECK (length(trim(full_name)) > 0),
    email VARCHAR(255) NOT NULL UNIQUE,
    student_id VARCHAR(50) NOT NULL UNIQUE,
    password_hash TEXT,
    authentication_provider VARCHAR(20) NOT NULL DEFAULT 'email'
        CHECK (authentication_provider IN ('email', 'google')),
    role VARCHAR(20) NOT NULL DEFAULT 'student'
        CHECK (role IN ('student', 'reviewer', 'admin')),
    notification_preferences JSONB NOT NULL DEFAULT
        '{"reports": true, "claims": true, "possible_matches": true}'::jsonb,
    is_active BOOLEAN NOT NULL DEFAULT TRUE,
    created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
    deleted_at TIMESTAMPTZ,
    CONSTRAINT users_password_provider_check CHECK (
        (authentication_provider = 'email' AND password_hash IS NOT NULL)
        OR authentication_provider = 'google'
    )
);

-- One table handles both Lost and Found reports, distinguished by report_type.

CREATE TABLE IF NOT EXISTS "user".item_reports (
    report_id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    user_id BIGINT NOT NULL REFERENCES "user".users(user_id) ON DELETE RESTRICT,
    item_name VARCHAR(160) NOT NULL CHECK (length(trim(item_name)) > 0),
    category VARCHAR(80) NOT NULL
        CHECK (category IN (
            'Electronics', 'Identification Cards', 'Bags and Wallets',
            'School Supplies', 'Clothing', 'Accessories', 'Keys', 'Other'
        )),
    description TEXT NOT NULL,
    report_type VARCHAR(10) NOT NULL CHECK (report_type IN ('LOST', 'FOUND')),
    image_path TEXT,
    date_lost_or_found DATE NOT NULL,
    approximate_time TIME,
    location VARCHAR(255) NOT NULL,
    additional_details TEXT,
    contact_preference VARCHAR(100),
    custody_information TEXT,
    listing_status VARCHAR(30) NOT NULL DEFAULT 'Pending Review'
        CHECK (listing_status IN (
            'Lost', 'Found', 'Pending Review', 'Approved Listing',
            'Resolved', 'Withdrawn'
        )),
    extra_data JSONB NOT NULL DEFAULT '{}'::jsonb,
    created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
    deleted_at TIMESTAMPTZ,
    CONSTRAINT item_report_status_type_check CHECK (
        (report_type = 'LOST' AND listing_status IN
            ('Lost', 'Pending Review', 'Approved Listing', 'Resolved', 'Withdrawn'))
        OR
        (report_type = 'FOUND' AND listing_status IN
            ('Found', 'Pending Review', 'Approved Listing', 'Resolved', 'Withdrawn'))
    )
);

CREATE TABLE IF NOT EXISTS "user".claims (
    claim_id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    claim_reference VARCHAR(40) UNIQUE,
    item_id BIGINT NOT NULL REFERENCES "user".item_reports(report_id) ON DELETE RESTRICT,
    claimant_user_id BIGINT NOT NULL REFERENCES "user".users(user_id) ON DELETE RESTRICT,
    explanation TEXT NOT NULL,
    distinctive_item_details TEXT NOT NULL,
    approximate_date_lost DATE,
    approximate_location_lost VARCHAR(255),
    supporting_evidence_path TEXT,
    contact_preference VARCHAR(100),
    claim_status VARCHAR(10) NOT NULL DEFAULT 'Pending'
        CHECK (claim_status IN ('Pending', 'Approved', 'Rejected')),
    reviewer_notes TEXT,
    reviewed_by BIGINT REFERENCES "user".users(user_id) ON DELETE SET NULL,
    created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
    reviewed_at TIMESTAMPTZ,
    deleted_at TIMESTAMPTZ,
    CONSTRAINT claims_one_per_user_item UNIQUE (item_id, claimant_user_id),
    CONSTRAINT claims_review_consistency CHECK (
        (claim_status = 'Pending' AND reviewed_at IS NULL)
        OR (claim_status IN ('Approved', 'Rejected') AND reviewed_at IS NOT NULL)
    )
);

CREATE TABLE IF NOT EXISTS "user".notifications (
    notification_id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    user_id BIGINT NOT NULL REFERENCES "user".users(user_id) ON DELETE CASCADE,
    title VARCHAR(180) NOT NULL,
    message TEXT NOT NULL,
    read_status BOOLEAN NOT NULL DEFAULT FALSE,
    related_report_id BIGINT REFERENCES "user".item_reports(report_id) ON DELETE SET NULL,
    related_claim_id BIGINT REFERENCES "user".claims(claim_id) ON DELETE SET NULL,
    created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
    read_at TIMESTAMPTZ,
    deleted_at TIMESTAMPTZ,
    CONSTRAINT notification_read_time_check CHECK (
        read_status = FALSE OR read_at IS NOT NULL
    )
);

-- Records an image search attempt. Real image recognition requires a connected
-- model/service; this table alone does not perform AI image recognition.

CREATE TABLE IF NOT EXISTS "user".image_searches (
    image_search_id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    user_id BIGINT NOT NULL REFERENCES "user".users(user_id) ON DELETE CASCADE,
    query_image_path TEXT NOT NULL,
    search_status VARCHAR(20) NOT NULL DEFAULT 'Submitted'
        CHECK (search_status IN ('Submitted', 'Processing', 'Completed', 'Failed', 'Demo')),
    service_name VARCHAR(100),
    created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
    completed_at TIMESTAMPTZ,
    result_metadata JSONB NOT NULL DEFAULT '{}'::jsonb
);

-- Stores results returned by a real or clearly labelled demo matching service.
-- Similarity score is optional and should only be stored if the service provides it.

CREATE TABLE IF NOT EXISTS "user".image_search_matches (
    image_search_id BIGINT NOT NULL
        REFERENCES "user".image_searches(image_search_id) ON DELETE CASCADE,
    report_id BIGINT NOT NULL
        REFERENCES "user".item_reports(report_id) ON DELETE RESTRICT,
    similarity_score NUMERIC(5,4)
        CHECK (similarity_score IS NULL OR similarity_score BETWEEN 0 AND 1),
    result_rank INTEGER CHECK (result_rank IS NULL OR result_rank > 0),
    created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
    PRIMARY KEY (image_search_id, report_id)
);

-- Soft-delete views: hide records marked deleted without physically removing them.

CREATE OR REPLACE VIEW "user".active_users AS
SELECT user_id, full_name, email, student_id, authentication_provider, role,
       notification_preferences, is_active, created_at, updated_at
FROM "user".users
WHERE deleted_at IS NULL;

CREATE OR REPLACE VIEW "user".active_item_reports AS
SELECT report_id, user_id, item_name, category, description, report_type,
       image_path, date_lost_or_found, approximate_time, location,
       additional_details, contact_preference, custody_information,
       listing_status, extra_data, created_at, updated_at
FROM "user".item_reports
WHERE deleted_at IS NULL;

CREATE OR REPLACE VIEW "user".active_claims AS
SELECT claim_id, claim_reference, item_id, claimant_user_id, explanation,
       distinctive_item_details, approximate_date_lost, approximate_location_lost,
       supporting_evidence_path, contact_preference, claim_status, reviewer_notes,
       reviewed_by, created_at, reviewed_at
FROM "user".claims
WHERE deleted_at IS NULL;

-- Indexes for dashboard, Explore, My Reports, My Claims and notifications.


CREATE INDEX IF NOT EXISTS idx_item_reports_type_status_date
    ON "user".item_reports (report_type, listing_status, date_lost_or_found DESC)
    WHERE deleted_at IS NULL;
CREATE INDEX IF NOT EXISTS idx_item_reports_category
    ON "user".item_reports (category) WHERE deleted_at IS NULL;
CREATE INDEX IF NOT EXISTS idx_item_reports_location
    ON "user".item_reports (location) WHERE deleted_at IS NULL;
CREATE INDEX IF NOT EXISTS idx_item_reports_user_created
    ON "user".item_reports (user_id, created_at DESC) WHERE deleted_at IS NULL;
CREATE INDEX IF NOT EXISTS idx_claims_user_status
    ON "user".claims (claimant_user_id, claim_status, created_at DESC)
    WHERE deleted_at IS NULL;
CREATE INDEX IF NOT EXISTS idx_claims_item
    ON "user".claims (item_id);
CREATE INDEX IF NOT EXISTS idx_notifications_user_unread
    ON "user".notifications (user_id, created_at DESC)
    WHERE read_status = FALSE AND deleted_at IS NULL;
CREATE INDEX IF NOT EXISTS idx_item_reports_extra_data_gin
    ON "user".item_reports USING GIN (extra_data);
CREATE INDEX IF NOT EXISTS idx_users_notification_preferences_gin
    ON "user".users USING GIN (notification_preferences);

-- Automatically maintain updated_at on edits.
CREATE OR REPLACE FUNCTION "user".campusfind_set_updated_at()
RETURNS TRIGGER LANGUAGE plpgsql AS $$
BEGIN
    NEW.updated_at := CURRENT_TIMESTAMP;
    RETURN NEW;
END;
$$;

DROP TRIGGER IF EXISTS trg_users_updated_at ON "user".users;

CREATE TRIGGER trg_users_updated_at
BEFORE UPDATE ON "user".users
FOR EACH ROW EXECUTE FUNCTION "user".campusfind_set_updated_at();


DROP TRIGGER IF EXISTS trg_item_reports_updated_at ON "user".item_reports;

CREATE TRIGGER trg_item_reports_updated_at
BEFORE UPDATE ON "user".item_reports
FOR EACH ROW EXECUTE FUNCTION "user".campusfind_set_updated_at();

-- Fill claim reference after the identity value is assigned.

CREATE OR REPLACE FUNCTION "user".campusfind_assign_claim_reference()
RETURNS TRIGGER LANGUAGE plpgsql AS $$
BEGIN
    IF NEW.claim_reference IS NULL OR NEW.claim_reference = '' THEN
        UPDATE "user".claims
        SET claim_reference = 'CF-' || TO_CHAR(NEW.created_at, 'YYYYMMDD')
            || '-' || LPAD(NEW.claim_id::TEXT, 6, '0')
        WHERE claim_id = NEW.claim_id;
    END IF;
    RETURN NEW;
END;
$$;

DROP TRIGGER IF EXISTS trg_claim_reference ON "user".claims;
CREATE TRIGGER trg_claim_reference
AFTER INSERT ON "user".claims
FOR EACH ROW EXECUTE FUNCTION "user".campusfind_assign_claim_reference();

COMMIT;

